---
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import { Status } from "@components/Lanyard";
import Link from "@components/Link.astro";
import ShinyText from "@components/ShinyText";
import SplitText from "@components/SplitText";
import { HOME, SITE, SOCIALS } from "@consts";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const blog = (await getCollection("blog"))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
	<Container>
		<aside data-pagefind-ignore>
			<SplitText
				text="hey, i'm barbarbar338!"
				className="font-semibold text-black dark:text-white"
				delay={50}
				animationFrom={{
					opacity: 0,
					transform: "translate3d(0, 50px, 0)",
				}}
				animationTo={{ opacity: 1, transform: "translate3d(0, 0, 0)" }}
				easing="easeOutCubic"
				threshold={0.2}
				client:load
			/>
			<Status client:load />
			<div class="space-y-16">
				<section>
					<article class="space-y-4">
						<span class="animate">
							<p>
								i'm an electrical and electronics engineering
								student with a focus on power electronics and
								sensors. outside of school, i work as a robotics
								integrator, often programming cnc machines and
								working with fanuc robots. i'm currently
								sharpening my skills in the karel language and
								robotics integration in manufacturing.
							</p>
							<p>
								on the software side, i' m into modern dev
								stacks and system automation. i regularly use
								github, linux, proxmox, docker, kubernetes, and
								ansible for my homelab. my go-to tools include
								rust, javascript, typescript, postgres, nestjs,
								nextjs, and tailwind. i enjoy building clean,
								scalable systems - and getting my hands dirty
								with hardware.
							</p>
						</span>

						<span class="animate">
							<p>
								i also run a growing youtube channel where i
								share tutorials on coding, system
								administration, and hardware projects - always
								with a focus on hands-on, practical learning.
							</p>

							<p>
								when i'm not building something, i'm probably
								gaming or hacking away on a personal project
								just for fun.
							</p>
						</span>
					</article>
				</section>

				<section class="animate space-y-6">
					<div
						class="flex flex-wrap items-center justify-between gap-y-2"
					>
						<h2 class="font-semibold text-black dark:text-white">
							latest posts
						</h2>
						<Link href="/blog">
							<ShinyText
								text="see all posts"
								className="underline"
								disabled={false}
								speed={2}
								client:load
							/>
						</Link>
					</div>
					<ul class="not-prose flex flex-col gap-4">
						{
							blog.map((post) => (
								<li>
									<ArrowCard entry={post} />
								</li>
							))
						}
					</ul>
				</section>

				<section class="animate space-y-4">
					<h2 class="font-semibold text-black dark:text-white">
						let's connect
					</h2>
					<article>
						<p>
							if you want to get in touch with me about something
							or just to say hi, reach out on social media or send
							me an email.
						</p>
					</article>
					<ul class="not-prose flex flex-wrap gap-2">
						{
							SOCIALS.map((SOCIAL) => (
								<li class="flex gap-x-2 text-nowrap">
									<Link
										href={SOCIAL.HREF}
										external
										aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
									>
										{SOCIAL.NAME}
									</Link>
									{"/"}
								</li>
							))
						}
						<li class="line-clamp-1">
							<Link
								href={`mailto:${SITE.EMAIL}`}
								aria-label={`Email ${SITE.TITLE}`}
							>
								{SITE.EMAIL}
							</Link>
						</li>
					</ul>
				</section>
			</div>
		</aside>
	</Container>
</Layout>
